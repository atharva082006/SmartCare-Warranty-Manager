# ============================================================
# SmartCare Backend Environment Template (.env.example)
# Copy this file to .env and adjust values for your local setup.
# DO NOT commit real secrets or passwords to version control.
# ============================================================

# Flask environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Application Secret Key (must be changed to a cryptographically secure random value in production)
SECRET_KEY=CHANGE_ME_SECRET_KEY

# JWT Secret Key (used for signing access tokens; must be secret and unique in production)
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY

# JWT access token lifetime in days (default: 1 day)
JWT_ACCESS_TOKEN_EXPIRES_DAYS=1

# PostgreSQL Connection String:
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# File storage location for uploaded document attachments
UPLOAD_FOLDER=uploads

# Allowed Frontend URL or comma-separated origins for CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Server host and port
HOST=127.0.0.1
PORT=5000

# Optional: Path to Tesseract OCR binary (leave empty if on system PATH)
# Example (Windows): C:\Program Files\Tesseract-OCR\tesseract.exe
# Example (Linux): /usr/bin/tesseract
TESSERACT_CMD=
